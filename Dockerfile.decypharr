# =============================================================================
#  Dockerfile.decypharr
#
#  Thin wrapper around the upstream Decypharr image that adds a /etc/passwd
#  entry for the runtime UID ("appuser").  This is required because the
#  container runs as `PUID:PGID` (via docker-compose.yml) and
#  fusermount3 calls `id -un` to resolve the username before mounting the
#  FUSE filesystem.  Without a matching passwd entry fusermount3 exits with:
#
#    fusermount3: could not determine username
#
#  …which prevents the rclone WebDAV mount from ever establishing (issue #24).
# =============================================================================

ARG DECYPHARR_VERSION=v2.4
FROM ghcr.io/sirrobot01/decypharr:${DECYPHARR_VERSION}

ARG APP_UID=1000

# Ensure a passwd entry exists for the runtime UID (required by fusermount3's
# `id -un` lookup). Reuse any existing account for APP_UID (e.g. root UID 0).
# BusyBox adduser also fails if the UID number collides with an existing group
# when no group is specified, so create/use a dedicated appuser group.
RUN set -eu; \
    existing_user="$(awk -F: -v uid="${APP_UID}" '$3 == uid { print $1; exit }' /etc/passwd || true)"; \
    if [ -n "${existing_user}" ]; then \
        echo "Using existing passwd entry '${existing_user}' for UID ${APP_UID}"; \
    else \
        existing_group="$(awk -F: -v gid="${APP_UID}" '$3 == gid { print $1; exit }' /etc/group || true)"; \
        if [ -n "${existing_group}" ]; then \
            adduser -u "${APP_UID}" -G "${existing_group}" -D -H -s /bin/sh appuser; \
        else \
            addgroup -g "${APP_UID}" appuser; \
            adduser -u "${APP_UID}" -G appuser -D -H -s /bin/sh appuser; \
        fi; \
    fi
